{
  "manifest_version": 3,
  "name": "Codex Browser",
  "version": "0.2.2",
  "description": "Local browser tools for Codex: existing tabs and sign-ins, JavaScript, page snapshots, and request capture.",
  "key": "",
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging",
    "storage",
    "tabs",
    "tabGroups"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
